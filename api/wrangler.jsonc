{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "publication-studio-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "publication-studio-db",
      "database_id": "fb1e4050-1530-499d-98e9-3a3157eac6db",
      "migrations_dir": "migrations"
    }
  ],
  // The Claude connector's OAuth store: clients, grants and token hashes.
  // Created with `wrangler kv namespace create OAUTH_KV`.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "c8fb2e13478244fc9db9a3bc95cc848b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "publication-studio-images"
    }
  ],
  "vars": {
    // The deployed SPA origin. CORS is pinned to exactly this; local
    // development overrides it in .dev.vars, which is gitignored.
    "ALLOWED_ORIGIN": "https://ryankolean.github.io",
    // This Worker's own origin. The Claude connector URL is this plus /mcp,
    // and every token is bound to it, so changing it means reconnecting.
    "PUBLIC_ORIGIN": "https://publication-studio-api.ryan-kolean.workers.dev"
  },
  "observability": {
    "enabled": true
  },
  // Staging: its own Worker, database, OAuth store and bucket, so the Claude
  // connector can be tried live without touching the real studio. Bindings
  // are not inherited, so each is listed again. Deploy with --env staging.
  "env": {
    "staging": {
      "name": "publication-studio-api-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "publication-studio-db-staging",
          "database_id": "67e0c27d-b8fb-4efb-a8b9-77804a2df850",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "2c318c9acc8849728f758f59064715bc"
        }
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "publication-studio-images-staging"
        }
      ],
      "vars": {
        "ALLOWED_ORIGIN": "https://ryankolean.github.io",
        "PUBLIC_ORIGIN": "https://publication-studio-api-staging.ryan-kolean.workers.dev"
      },
      "observability": {
        "enabled": true
      }
    }
  }
}
