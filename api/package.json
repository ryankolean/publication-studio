{
  "name": "@publication-studio/api",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply publication-studio-db --local",
    "migrate:remote": "wrangler d1 migrations apply publication-studio-db --remote",
    "seed-user": "node scripts/seed-user.mjs",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "test-account": "node scripts/ensure-test-account.mjs",
    "research:check": "vite-node scripts/check-research.ts --",
    "research:import": "vite-node scripts/import-research.ts --",
    "style:suggest": "vite-node scripts/suggest-tags.ts --",
    "match:report": "vite-node scripts/match-report.ts --"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.3",
    "zod": "^4.6.7"
  }
}
